---
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';
---

{(config.social ?? []).map(({ label, href, icon }) => (
  <a href={href} target="_blank" rel="me noopener noreferrer" class="sl-flex">
    <span class="sr-only">{label}</span>
    <Icon name={icon} />
  </a>
))}

<style>
  a { color: var(--sl-color-text-accent); padding: 0.5em; margin: -0.5em; }
  a:hover { color: var(--sl-color-white); }
</style>
