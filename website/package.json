    "astro": "^7.3.5",
    "astro-expressive-code": "^0.44.2",
    "codemirror": "^6.0.2",
    "turndown": "^7.2.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
